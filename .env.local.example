# ─── App auth (NextAuth + Azure AD) ──────────────────────────────────────────
# REQUIRED — JWT signing secret for NextAuth sessions. Generate: openssl rand -hex 32
NEXTAUTH_SECRET=
# REQUIRED — canonical app URL (http://localhost:3000 locally; prod URL on Vercel)
NEXTAUTH_URL=
# REQUIRED — Azure AD app registration (Entra ID) for Microsoft sign-in
AZURE_AD_CLIENT_ID=
# REQUIRED — Azure AD app registration client secret
AZURE_AD_CLIENT_SECRET=
# REQUIRED — Azure AD tenant ID
AZURE_AD_TENANT_ID=

# ─── Supabase (project: proguard-claims / cxqzacvdcexcxhrssafl) ──────────────
# REQUIRED — Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# REQUIRED — service role key; server-side only, bypasses RLS (all tables are deny-all RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Machine-to-machine auth ─────────────────────────────────────────────────
# REQUIRED — bearer secret for /api/sync manual triggers and internal BFF proxies.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Zoho CRM (claims/estimates/payments/inspections source of truth) ────────
# REQUIRED — OAuth client for the Zoho CRM API (self-client refresh-token flow)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ─── Septic GTM Supabase (external — phone_calls table for Call Logs) ────────
# REQUIRED — service key for the Septic GTM Supabase project (read-only use)
SEPTIC_GTM_SERVICE_KEY=

# ─── 3CX (call log sync) ─────────────────────────────────────────────────────
# REQUIRED for call-log sync — PBX API base URL, e.g. https://<pbx-host>/xapi/v1
THREECX_API_BASE_URL=
# REQUIRED for call-log sync
THREECX_API_KEY=
THREECX_CLIENT_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# OPTIONAL — enables the AI narrative on the Weekly Digest; route degrades gracefully without it
ANTHROPIC_API_KEY=
# OPTIONAL — overrides the base URL the digest narrative uses to call /api/digest
# (falls back to the request host when unset)
NEXT_PUBLIC_APP_URL=
